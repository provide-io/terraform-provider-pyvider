[8.731, "o", "\u001b[1;36m$ uv tool install --refresh --quiet tofusoup==0.8.2\u001b[0m\r\n\r\n"]
[11.569, "o", "\u001b[1;36m$ provider=$(uv run python ci/provider-linting-artifact-path.py dist/provider-linting-build-provenance.json)\u001b[0m\r\n\r\n"]
[14.407, "o", "\u001b[1;36m$ soup lint tests/e2e/provider-linting/lint.soup.toml --provider \"$provider\" --lane direct\u001b[0m\r\n"]
