[14.973, "o", "on linux_amd64\r\n\r\n"]
[16.251, "o", "\u001b[1;36m$ soup lint tests/e2e/provider-linting/lint.soup.toml --provider \"$provider\" --opentofu \"$tofu\" --lane opentofu\u001b[0m\r\n"]
