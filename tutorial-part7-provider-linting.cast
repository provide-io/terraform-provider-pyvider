[1.35, "o", "Part 7: author and verify one provider lint rule.\r\n"]
[2.7, "o", "Every command below is runnable from this checked-in tutorial directory.\r\n\r\n"]
[4.351, "o", "\u001b[1;36m$ uv sync --frozen\u001b[0m\r\n\r\n"]
[6.002, "o", "\u001b[1;36m$ uv run pytest tests/test_linting.py -q\u001b[0m\r\n"]
[7.352, "o", ".........                                                                                              [100%]\r\n"]
[8.702, "o", "9 passed in 0.26s\r\n\r\n"]
[10.353, "o", "\u001b[1;36m$ uv run flavor pack --quiet --manifest pyproject.toml\u001b[0m\r\n"]
[11.853, "o", "Built and verified dist/terraform-provider-mycloud.psp\r\n\r\n"]
[13.504, "o", "\u001b[1;36m$ install -m 755 dist/terraform-provider-mycloud.psp dist/terraform-provider-mycloud\u001b[0m\r\n\r\n"]
[15.154, "o", "\u001b[1;36m$ uvx --from tofusoup==0.8.2 soup lint lint.soup.toml --provider \"$PWD/dist/terraform-provider-mycloud\" --lane direct\u001b[0m\r\n"]
