[23.999, "o", "\u001b[1m \u001b[0m\u001b[1mSta\u2026\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mPha\u2026\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m   #   \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mTest Suite   \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m   Elapsed\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mProv \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m Res \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mData \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mFunc \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mOuts \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mLast Log                           \u001b[0m\u001b[1m \u001b[0m\r\n  \u001b[2m\ud83d\udca4\u001b[0m    \ud83d\udca4  \u001b[2m \u001b[0m\u001b[2m  \u001b[0m\u001b[2m1/1\u001b[0m\u001b[2m  \u001b[0m\u001b[2m \u001b[0m\u001b[36m \u001b[0m\u001b[1;36mprovider-lin\u2026\u001b[0m\u001b[36m \u001b[0m\u001b[35m \u001b[0m\u001b[35m          \u001b[0m\u001b[35m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[33m \u001b[0m\u001b[33m                                   \u001b[0m\u001b[33m \u001b[0m"]
[24.007, "o", "\r\u001b[2K\u001b[1A\u001b[2K\u001b[1m\ud83d\ude80 Tofusoup Stir\u001b[0m\r\n\u001b[1m \u001b[0m\u001b[1mSta\u2026\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mPha\u2026\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m   #   \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mTest Suite   \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m   Elapsed\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mProv \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m Res \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mData \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mFunc \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mOuts \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mLast Log                           \u001b[0m\u001b[1m \u001b[0m\r\n  \u001b[2m\ud83d\udca4\u001b[0m    \ud83d\udca4  \u001b[2m \u001b[0m\u001b[2m  \u001b[0m\u001b[2m1/1\u001b[0m\u001b[2m  \u001b[0m\u001b[2m \u001b[0m\u001b[36m \u001b[0m\u001b[1;36mprovider-lin\u2026\u001b[0m\u001b[36m \u001b[0m\u001b[35m \u001b[0m\u001b[35m          \u001b[0m\u001b[35m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[33m \u001b[0m\u001b[33m                                   \u001b[0m\u001b[33m \u001b[0m"]
[24.012, "o", "\r\u001b[2K\u001b[1A\u001b[2KFound \u001b[1;36m1\u001b[0m test suites in \r\n\u001b[32m'<workspace>/demo/provider-li\u001b[0m\r\n\u001b[32mnting'\u001b[0m. Running up to \u001b[1;36m4\u001b[0m in parallel\u001b[33m...\u001b[0m\r\n\u001b[1m \u001b[0m\u001b[1mSta\u2026\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mPha\u2026\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m   #   \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mTest Suite   \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m   Elapsed\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mProv \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m Res \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mData \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mFunc \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mOuts \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mLast Log                           \u001b[0m\u001b[1m \u001b[0m\r\n  \u001b[2m\ud83d\udca4\u001b[0m    \ud83d\udca4  \u001b[2m \u001b[0m\u001b[2m  \u001b[0m\u001b[2m1/1\u001b[0m\u001b[2m  \u001b[0m\u001b[2m \u001b[0m\u001b[36m \u001b[0m\u001b[1;36mprovider-lin\u2026\u001b[0m\u001b[36m \u001b[0m\u001b[35m \u001b[0m\u001b[35m          \u001b[0m\u001b[35m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[34m \u001b[0m\u001b[34m  0  \u001b[0m\u001b[34m \u001b[0m\u001b[33m \u001b[0m\u001b[33m                                   \u001b[0m\u001b[33m \u001b[0m\r\u001b[2K\u001b[1A\u001b[2K\r\n\u001b[1m \u001b[0m\u001b[1mSta\u2026\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mPha\u2026\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m   "]
